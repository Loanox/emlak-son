@{
    ViewData["Title"] = "My Favorites";
}

<div class="row mb-4">
    <div class="col d-flex justify-content-between align-items-center">
        <h2>My Favorite Properties</h2>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4" id="fav-properties-list">
    <div class="col text-center w-100" id="loading-spinner">
        <div class="spinner-border text-danger" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var token = localStorage.getItem('auth_token');
            if (!token) {
                window.location.href = '/Auth/Login';
                return;
            }

            $.ajax({
                url: 'https://localhost:7107/api/favorites',
                type: 'GET',
                headers: {
                    'Authorization': 'Bearer ' + token
                },
                success: function(data) {
                    $('#loading-spinner').remove();
                    var list = $('#fav-properties-list');

                    if (!data || data.length === 0) {
                        list.append('<div class="col w-100"><div class="alert alert-info">You have no favorite properties yet.</div></div>');
                        return;
                    }

                    data.forEach(function(fav) {
                        var p = fav.property;
                        var card = `
                            <div class="col">
                                <div class="card h-100 shadow-sm border-danger">
                                    <div class="card-body">
                                        <h5 class="card-title fw-bold text-truncate">${p.title}</h5>
                                        <span class="badge ${p.status === 'Active' ? 'bg-success' : 'bg-secondary'} mb-2">${p.status || 'Active'}</span>
                                        <h6 class="text-danger mb-3">$${p.price.toLocaleString()}</h6>
                                        <p class="text-muted small mb-3"><i class="bi bi-geo-alt"></i> ${p.city}, ${p.district}</p>
                                        <a href="/Properties/Details/${p.id}" class="btn btn-sm btn-outline-danger w-100 mb-2"><i class="bi bi-eye"></i> View Detail</a>
                                        <button class="btn btn-sm btn-danger w-100" onclick="removeFav(${fav.id})"><i class="bi bi-trash"></i> Remove from Favorites</button>
                                    </div>
                                </div>
                            </div>
                        `;
                        list.append(card);
                    });
                },
                error: function() {
                    $('#loading-spinner').remove();
                    $('#fav-properties-list').html('<div class="col w-100"><div class="alert alert-danger">Error loading your favorites.</div></div>');
                }
            });
        });

        function removeFav(id) {
            if (confirm("Are you sure you want to remove this property from your favorites?")) {
                $.ajax({
                    url: 'https://localhost:7107/api/favorites/' + id,
                    type: 'DELETE',
                    headers: {
                        'Authorization': 'Bearer ' + localStorage.getItem('auth_token')
                    },
                    success: function() {
                        location.reload();
                    },
                    error: function() {
                        alert('Could not remove favorite.');
                    }
                });
            }
        }
    </script>
}
